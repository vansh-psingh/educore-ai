# ============================================================
# EDUCORE AI - backend configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- AI providers (at least one required) ----------
# Gemini key (primary). Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional OpenAI-compatible provider (used when key starts with "sk-")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60

# ---------- PostgreSQL (required for production mode) ----------
# When set, ALL app data moves from JSON files to PostgreSQL.
# Neon/Supabase format also accepted:
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#   or jdbc:postgresql://host:5432/dbname?user=u&password=p
DATABASE_URL=
# Discrete alternative (used only if DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=educore
# PGUSER=educore
# PGPASSWORD=

# ---------- SMTP (password-reset emails) ----------
# Without these, reset links are written to the SERVER LOG only.
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_TLS=starttls        # starttls | ssl | none

# Public URL of the frontend, used inside password-reset emails.
APP_BASE_URL=https://educore-ai-9dc3c.web.app

# ---------- Auth ----------
# Secret for signing JWT access/refresh tokens. Generate: openssl rand -base64 32
AUTH_SECRET=

# ---------- Server ----------
# PORT is set automatically on cloud hosts; defaults to 8080 locally.
# PORT=8080

# ---------- CAPTCHA (Cloudflare Turnstile, free) ----------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY is public (sent to the browser); TURNSTILE_SECRET_KEY
# is backend-only and must NEVER appear in frontend code.
# If unset, CAPTCHA is skipped (development mode only - set both in production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
